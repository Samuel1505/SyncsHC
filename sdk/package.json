{
  "name": "@syncshc/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for SyncsHC Stacks Smart Contracts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "tsc"
  },
  "dependencies": {
    "@stacks/transactions": "^7.2.0",
    "@stacks/network": "^7.3.1",
    "@stacks/keychain": "^4.3.8",
    "@stacks/common": "^7.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.16"
  }
}